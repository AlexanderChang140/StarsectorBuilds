{
    "name": "backend",
    "private": true,
    "main": "index.js",
    "type": "module",
    "scripts": {
        "dev": "nodemon --watch src --exec tsx src/index.ts",
        "db:setup": "tsx src/scripts/setupDb.ts",
        "db:gen": "npx kysely-codegen --out-file ./src/db/db.d.ts",
        "db:cleanup": "tsx src/scripts/cleanupDb.ts",
        "import:mod": "tsx src/scripts/importMod.ts"
    },
    "dependencies": {
        "@starsector-builds/shared": "*",
        "argon2": "^0.44.0",
        "cookie-parser": "^1.4.7",
        "csv": "^6.4.1",
        "dotenv": "^17.2.1",
        "express": "^5.1.0",
        "fast-glob": "^3.3.3",
        "json-stable-stringify": "^1.3.0",
        "kysely": "^0.28.9",
        "pg": "^8.16.3",
        "pg-copy-streams": "^7.0.0",
        "sharp": "^0.35.5",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.38.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.3",
        "@types/node": "^24.7.0",
        "@types/pg": "^8.15.5",
        "eslint": "^9.39.2",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "jsonc-parser": "^3.3.1",
        "kysely-codegen": "^0.19.0",
        "nodemon": "^3.1.10",
        "tsx": "^4.23.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.1"
    }
}
